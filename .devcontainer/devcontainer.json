// Dev environment for Hazbat: Python 3.12 + a private PostgreSQL database.
// Works in GitHub Codespaces (nothing to install) or locally with VS Code "Dev Containers" + Docker.
// The database is created from schema.sql on first start, plus a dev login (dev / dev).
{
  "name": "Hazbat (Python 3.12 + PostgreSQL 16)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "forwardPorts": [8000, 5432],
  "portsAttributes": {
    "8000": { "label": "Hazbat app", "onAutoForward": "openBrowser" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },

  "postCreateCommand": "pip install -r requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "sqltools.connections": [
          {
            "name": "Hazbat dev DB",
            "driver": "PostgreSQL",
            "server": "localhost",
            "port": 5432,
            "database": "bmac",
            "username": "postgres",
            "password": "postgres"
          }
        ]
      }
    }
  },

  // Optional: add GEMINI_API_KEY as a Codespaces secret (GitHub → Settings → Codespaces) for HAZbot
  "secrets": {
    "GEMINI_API_KEY": { "description": "Google Gemini API key used by HAZbot (optional)" }
  }
}
